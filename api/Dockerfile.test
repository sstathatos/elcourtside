# Test image for the API — pytest against the real fixtures.
#
# Separate from Dockerfile because the two want opposite things from the build
# context: the runtime image must not carry tests or dev dependencies, and the
# test image is useless without them. BuildKit reads the ignore file next to
# the Dockerfile (Dockerfile.test.dockerignore), so each gets its own context
# rules rather than one file trying to serve both.
#
#   docker compose --profile test run --rm api-test

FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /src
COPY . ./

# Editable, so a failing test points at /src and the traceback matches the
# files on your disk rather than a copy under site-packages.
RUN pip install --no-cache-dir -e '.[dev]'

# -q: the suite is large enough that per-test dots are the useful signal.
CMD ["pytest", "-q"]
