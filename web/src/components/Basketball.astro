---
/**
 * The site's mark — a flat basketball seen at a three-quarter angle, drawn in
 * the site's design language: charcoal outline like every bordered element on
 * the page, flat accent-orange fill, no gradients.
 *
 * The seams are the front-view icon's four circles (central and two side
 * meridians plus the equator) computed on a sphere turned 30° about its
 * vertical axis, pitched 12° toward the viewer and leaned 18° in the picture
 * plane, with everything behind the horizon culled. This all runs once at
 * build time — the rendered SVG is static.
 *
 * Fills and strokes are presentation attributes, not CSS classes — an earlier
 * version painted the ball with a scoped `.skin { fill: … }` rule, and where
 * that rule didn't reach, the circle fell back to SVG's default fill: black.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 96, class: className = '' } = Astro.props;

const R = 46;
const CX = 52;
const CY = 52;
const SAMPLES = 144;

const SPIN = 30;
const PITCH = 12;
const LEAN = -18;
const SIDE_LON = 52;
/** Cull anything this close to (or beyond) the horizon; the outline ring hides
 * the seam ends so they appear to run right into the edge. */
const HORIZON = 0.05;

const rad = (d: number) => (d * Math.PI) / 180;

interface P3 {
  x: number;
  y: number;
  z: number;
}

const spinY = (p: P3, a: number): P3 => ({
  x: p.x * Math.cos(a) + p.z * Math.sin(a),
  y: p.y,
  z: -p.x * Math.sin(a) + p.z * Math.cos(a),
});
const pitchX = (p: P3, a: number): P3 => ({
  x: p.x,
  y: p.y * Math.cos(a) - p.z * Math.sin(a),
  z: p.y * Math.sin(a) + p.z * Math.cos(a),
});
const leanZ = (p: P3, a: number): P3 => ({
  x: p.x * Math.cos(a) - p.y * Math.sin(a),
  y: p.x * Math.sin(a) + p.y * Math.cos(a),
  z: p.z,
});

/** Contiguous front-facing runs become subpaths; the rest is behind the ball. */
function toPath(points: P3[]): string {
  const runs: P3[][] = [];
  let run: P3[] = [];
  for (const p of points) {
    if (p.z <= HORIZON) {
      if (run.length) runs.push(run);
      run = [];
      continue;
    }
    run.push(p);
  }
  if (run.length) runs.push(run);
  return runs
    .filter((r) => r.length > 3)
    .map(
      (r) =>
        'M' +
        r.map((p) => `${(CX + R * p.x).toFixed(1)} ${(CY - R * p.y).toFixed(1)}`).join('L'),
    )
    .join(' ');
}

function curve(at: (t: number) => P3): string {
  const points: P3[] = [];
  for (let i = 0; i <= SAMPLES; i++) {
    const t = (2 * Math.PI * i) / SAMPLES;
    points.push(leanZ(pitchX(spinY(at(t), rad(SPIN)), rad(PITCH)), rad(LEAN)));
  }
  return toPath(points);
}

const meridian =
  (lon: number) =>
  (t: number): P3 => ({
    x: Math.sin(t) * Math.sin(rad(lon)),
    y: Math.cos(t),
    z: Math.sin(t) * Math.cos(rad(lon)),
  });

const seams = [
  curve(meridian(0)),
  curve(meridian(SIDE_LON)),
  curve(meridian(-SIDE_LON)),
  curve((t) => ({ x: Math.sin(t), y: 0, z: Math.cos(t) })),
].filter(Boolean);

const SKIN = '#f04e23';
const LINE = '#17150f';
---

<svg
  class:list={['ball', className]}
  width={size}
  height={size}
  viewBox="0 0 104 104"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="52" cy="52" r="46" fill={SKIN}></circle>
  <g fill="none" stroke={LINE} stroke-width="2.5" stroke-linecap="round">
    {seams.map((d) => <path d={d} />)}
  </g>
  <circle cx="52" cy="52" r="46" fill="none" stroke={LINE} stroke-width="3"></circle>
</svg>

<style>
  .ball {
    display: block;
    flex: none;
  }
</style>
