---
import Base from '../../layouts/Base.astro';
import { TeamCrests } from '../../islands/HeaderArt.tsx';
import Teams from '../../islands/Teams.tsx';
---

<Base
  title="Teams — elcourtside"
  description="Euroleague team stats: pace, fouls drawn per 100 possessions, biggest scoring runs and blown leads, clutch scoring."
>
  <div class="page-head">
    <div>
      <h1 class="page-title">Teams</h1>
      <p class="page-intro">
        Season totals per club, including the play-by-play indexes: biggest run,
        biggest blown lead, clutch points and fouls drawn per 100 possessions.
      </p>
    </div>
    <TeamCrests client:load />
  </div>

  <Teams client:load />
</Base>
